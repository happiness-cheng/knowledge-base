# Knowledge Base 环境变量配置
# 复制此文件为 .env 并填入实际值

# 运行环境（Docker Compose 部署必须设为 production）
APP_ENV=production

# MySQL（全部替换为随机强密码）
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_DATABASE=knowledge_base
MYSQL_USER=knowledge_base_app
MYSQL_PASSWORD=replace-with-a-long-random-application-password
DATABASE_URL=mysql+pymysql://knowledge_base_app:replace-with-a-long-random-application-password@mysql:3306/knowledge_base?charset=utf8mb4

# AI 配置（管理员默认 Key，用户可在应用内配置自己的）
AI_API_KEY=sk-your-api-key-here
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL_NAME=deepseek-chat

# JWT 密码签名密钥（生产环境必须替换为至少 32 位随机字符串）
SECRET_KEY=replace-with-a-random-string-of-at-least-32-characters

# 用户自定义 AI Key 的加密密钥（使用 Python 生成：Fernet.generate_key().decode()）
AI_KEY_ENCRYPTION_KEY=replace-with-a-valid-fernet-key-generated-by-python

# CORS 允许的前端域名
# 本地开发不用改，部署时改成你的域名
# CORS_ORIGINS=["http://localhost:5173","https://your-domain.com"]

# 生产主链路固定 RAGFlow；Chroma 仅开发/离线测试/显式回退。
# RAGFlow 1.0 需要先按官方 docker compose 启动，并在 UI 里创建 API Key。
KB_RETRIEVAL_BACKEND=ragflow
RAGFLOW_BASE_URL=http://ragflow:9380
RAGFLOW_API_KEY=replace-with-your-ragflow-api-key
RAGFLOW_DATASET_PREFIX=kb_user
RAGFLOW_TIMEOUT_SECONDS=30
# 留空表示使用 RAGFlow 服务端默认 embedding；不要和已有索引混用不同模型。
RAGFLOW_EMBEDDING_MODEL=
# 36 题受控实验：keywords 0.3 的 Hit@3/证据覆盖优于 0.7；小样本可回退。
RAGFLOW_KEYWORDS_SIMILARITY_WEIGHT=0.3
RAGFLOW_SIMILARITY_THRESHOLD=0.2

# 仅 chroma 后端需要；ragflow 后端可留空
KB_CHROMA_URL=
